# LLM Provider Configuration
# Supported providers: openai, gemini, ollama, rule (offline deterministic extractor)
LLM_PROVIDER=rule
LLM_MODEL=gpt-4o-mini

# API Keys (optional if using rule provider or ollama)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Ollama Configuration (if using local ollama)
OLLAMA_BASE_URL=http://localhost:11434

# Pipeline Configuration
DB_PATH=data/postings.db
DUCKDB_PATH=data/postings.duckdb
CSV_OUTPUT_PATH=output/job_postings.csv
JSON_OUTPUT_PATH=output/job_postings.json

# Scraping & Politeness Limits
REQUEST_DELAY_SECONDS=1.0
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
USER_AGENT=B2BMarketIntelligenceBot/1.0 (+https://example.com/bot; research data collection)

# Filtering limits
MAX_POSTINGS_PER_SOURCE=100
LOG_LEVEL=INFO
